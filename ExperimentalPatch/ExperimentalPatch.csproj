<Project Sdk="Microsoft.NET.Sdk">

  <!-- ════════════════════════════════════════════════════════════════════════
       ExperimentalPatch —— 实验性补丁层（宿主 TuneLab.csproj 直接 ProjectReference）。
       补丁不依赖宿主任何内部类型：只能看到 Abstractions 里的锚点契约；
       宿主想看的能力经 IHostServices / 各锚点 payload 显式开出去。
       加补丁 = 在 Patches/ 下加一个带 [Patch] 的 IPatch 实现，不改任何注册表。
       约定见 .agents/AGENTS.md。
       ════════════════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TuneLab.ExperimentalPatch</AssemblyName>
    <RootNamespace>TuneLab.ExperimentalPatch</RootNamespace>
    <!-- 实验层不参与上游打包/版本号体系，跟随宿主版本即可。 -->
    <Version>2.1.1</Version>
  </PropertyGroup>

  <!-- Avalonia 是第三方渲染库（版本随宿主）；TuneLab.GUI 是控件库（不是宿主程序集）——
       混音台里需要"和宿主同款"的 Slider / DraggableNumberBox 时直接复用它，不要再造一套。
       TuneLab.GUI 的类型大多是 internal，靠它的 InternalsVisibleTo(TuneLab.ExperimentalPatch) 开出来。

       仍然**不引用 TuneLab 宿主程序集**（那才是会随上游重构漂移、也违反补丁边界的面）。
       自绘控件（Fader / PanKnob / 通道条）继续用 UI/Palette.cs 的主题色镜像，取舍见其顶部注释。 -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.15" />
    <ProjectReference Include="..\TuneLab.GUI\TuneLab.GUI.csproj" />
  </ItemGroup>

  <!-- MixerEngine / InsertHost 是本目录下的**独立工程**（被宿主引用，而不是被本工程引用）。
       默认的 **/*.cs 通配会把它们的源码和 obj 生成文件一起吞进来，故显式排除。 -->
  <ItemGroup>
    <Compile Remove="MixerEngine/**" />
    <Compile Remove="InsertHost/**" />
    <None Remove="MixerEngine/**" />
    <None Remove="InsertHost/**" />
    <EmbeddedResource Remove="MixerEngine/**" />
    <EmbeddedResource Remove="InsertHost/**" />
    <!-- VstBridge/ 是独立的 x86 桥进程（不进本工程），但它的协议文件要被
         InsertHost 与 VstBridge 各自编译 —— 别让本工程的默认通配把 **/*.cs 吞进来。 -->
    <Compile Remove="VstBridge/**" />
    <None Remove="VstBridge/**" />
    <EmbeddedResource Remove="VstBridge/**" />

    <!-- VstBridge.X64/ 是同一套源码的 64 位构建（只有 csproj，没有 .cs）。
         它的 obj/ 会生成 AssemblyInfo.cs，必须一起排除，否则这里会撞 CS0579。 -->
    <Compile Remove="VstBridge.X64/**" />
    <None Remove="VstBridge.X64/**" />
    <EmbeddedResource Remove="VstBridge.X64/**" />
  </ItemGroup>

</Project>
