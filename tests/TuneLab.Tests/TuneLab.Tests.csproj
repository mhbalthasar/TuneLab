<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TuneLab\TuneLab.csproj" />
    <!-- 插入效果的假后端直接在这里单测（真 VST3 后端要机器上有 64 位插件，另说）。
         宿主已经引了 InsertHost；这里显式再引一次，是因为测试要直接用它的类型而不是透过宿主。 -->
    <ProjectReference Include="..\..\ExperimentalPatch\InsertHost\InsertHost.csproj" />
    <!-- 命令行：保留参数名与批量文件切词的封条要读它的唯一真源，不另抄一份。 -->
    <ProjectReference Include="..\..\TuneLab.Cli\TuneLab.Cli.csproj" />
    <!-- 安装器：命令行是向导的镜像，"默认值与向导一致"这条约定由 SetupCliOptionsTests 机器可检。 -->
    <ProjectReference Include="..\..\TuneLab.Setup\TuneLab.Setup.csproj" />
  </ItemGroup>

  <!-- 真 VST3 集成测试（Vst3IntegrationTests）要进程内加载原生宿主。
       dll 由 InsertHost 构建出来；这里拷一份到测试输出目录，否则 Vst3Backend
       会报"原生库缺失"而整组跳过 —— 那是部署漏拷，不是"机器没插件"。 -->
  <ItemGroup>
    <None Include="..\..\ExperimentalPatch\InsertHost\Native\win-x64\ownvst3.tlhost.dll"
          CopyToOutputDirectory="PreserveNewest" Link="ownvst3.tlhost.dll" />
  </ItemGroup>

</Project>
